# Wspólne ustawienia edytora. Uzupełnia .gitattributes: tam pilnujemy,
# co ląduje w repo, tutaj — jak edytory zapisują pliki u każdego z nas.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: dwie spacje na końcu linii to celowe łamanie wiersza
[*.md]
trim_trailing_whitespace = false
