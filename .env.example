# Wzorzec zmiennych środowiskowych — skopiuj do .env (ignorowany przez gita).
# Moduł 1 (sklep z kursami) — jedyna warstwa czytająca tę zmienną
# (pilnuje straznik-granic).
DB1_URL=postgres://kursy:kursy-dev@localhost:5432/db1_kursy

# Tymczasowy token akcji kreatora (dyspozytor m1) — pełne uwierzytelnianie
# da Plugin 3. W .env ustaw własną, losową wartość.
KREATOR_TOKEN=ustaw-wlasny-token

# Opcjonalne — tylko do protokołu pomiarów (README, sekcja „Pomiar
# wydajności i SEO"): klucz PageSpeed Insights API dla tools/pomiar-psi.mjs.
# Bez niego działa wszystko poza pomiarem na serwerach Google.
# PAGESPEED_KLUCZ=
