  <diagram id="1--Jak-to-dzia-a--dla-ka-dego-" name="1. Jak to działa (dla każdego)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="x1" value="Automatic AI — Płatności: jak to działa" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="Wtyczka 2 z 3. Nie jest kasą ani bramką płatności — jest SZWEM, który spina kurs ze sklepem WooCommerce i z dostępem w Tutor LMS." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1250" height="24" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="Droga klienta — od przycisku do kursu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#f7faff;strokeColor=#3a6ea5;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Klient" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;strokeColor=#7a5c00;" vertex="1" parent="1">
          <mxGeometry x="70" y="190" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="1. Klika „Dołączam”&lt;br&gt;&lt;br&gt;na stronie kursu&lt;br&gt;/szkolenia/&amp;lt;kurs&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#dae8fc;strokeColor=#3a6ea5;" vertex="1" parent="1">
          <mxGeometry x="150" y="165" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="2. Kasa&lt;br&gt;&lt;br&gt;od razu z kursem&lt;br&gt;w koszyku — bez&lt;br&gt;etapu koszyka" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#f0f0f0;strokeColor=#8a8a8a;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="165" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="3. Płaci&lt;br&gt;&lt;br&gt;konto zakłada się&lt;br&gt;samo przy zakupie" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#f0f0f0;strokeColor=#8a8a8a;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="165" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="4. Dostaje maile&lt;br&gt;&lt;br&gt;„Ustaw hasło i wejdź”&lt;br&gt;„Twój kurs jest gotowy”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#dae8fc;strokeColor=#3a6ea5;" vertex="1" parent="1">
          <mxGeometry x="900" y="165" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="5. Ma dostęp&lt;br&gt;&lt;br&gt;kurs czeka&lt;br&gt;w „Moich kursach”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#d5e8d4;strokeColor=#4d7f3f;" vertex="1" parent="1">
          <mxGeometry x="1170" y="165" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="a4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="n6" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="n7" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="n8" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t15" value="Przy przelewie kroki 4 i 5 dzieli nawet kilka dni — dlatego to DWA osobne maile, a nie jeden." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
          <mxGeometry x="900" y="285" width="510" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g16" value="Druga rola: cena kursu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#f7faff;strokeColor=#3a6ea5;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="720" height="300" as="geometry" />
        </mxCell>
        <mxCell id="d17" value="Cena w kreatorze&lt;br&gt;(nasza baza)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="70" y="450" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="Produkt&lt;br&gt;WooCommerce&lt;br&gt;cena regularna" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#f0f0f0;strokeColor=#8a8a8a;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="455" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="Strona kursu&lt;br&gt;pokazuje cenę,&lt;br&gt;którą klient zapłaci" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#d5e8d4;strokeColor=#4d7f3f;" vertex="1" parent="1">
          <mxGeometry x="560" y="455" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e20" value="kopiujemy&lt;br&gt;w jedną stronę" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="d17" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e21" value="cena z promocją,&lt;br&gt;jeśli właściciel ją ustawi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=1.5;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="n18" target="n19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t22" value="CENĘ USTAWIA SIĘ W KREATORZE — i tylko tam.&lt;br&gt;&lt;br&gt;Promocję można dodać w WooCommerce i strona ją pokaże. Ale cena regularna zmieniona ręcznie w WooCommerce wróci do naszej przy najbliższym zapisie kursu. To świadomy koszt jednego źródła prawdy." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
          <mxGeometry x="70" y="560" width="670" height="120" as="geometry" />
        </mxCell>
        <mxCell id="g23" value="Czego ta wtyczka NIE robi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#fafafa;strokeColor=#8a8a8a;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="400" width="740" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="Nie ma własnej kasy&lt;br&gt;ani własnej bramki płatności&lt;br&gt;&lt;br&gt;koszyk, kasę, płatność i faktury&lt;br&gt;bierze WooCommerce" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#f0f0f0;strokeColor=#8a8a8a;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="450" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="Nie trzyma klientów&lt;br&gt;ani zamówień&lt;br&gt;&lt;br&gt;ma je WooCommerce;&lt;br&gt;dostęp do kursu ma Tutor LMS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#f0f0f0;strokeColor=#8a8a8a;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1185" y="450" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="Nasze są DWIE rzeczy, których nie wie ani WooCommerce, ani Tutor:&lt;br&gt;&lt;br&gt;· który produkt sprzedaje który kurs&lt;br&gt;· czy klient NAPRAWDĘ dostał to, za co zapłacił (dostęp i maile)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#dae8fc;strokeColor=#3a6ea5;" vertex="1" parent="1">
          <mxGeometry x="830" y="570" width="685" height="110" as="geometry" />
        </mxCell>
        <mxCell id="x27" value="Legenda:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#dae8fc;strokeColor=#3a6ea5;" vertex="1" parent="1">
          <mxGeometry x="40" y="756" width="24" height="24" as="geometry" />
