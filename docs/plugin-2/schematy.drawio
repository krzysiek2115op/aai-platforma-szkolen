          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e32" value="pytamy o ZAPIS,&lt;br&gt;nigdy o „dostęp”" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=1.5;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="n28" target="n29">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g33" value="Odpowiedzi do Pluginu 1 (filtry)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#f4fbf2;strokeColor=#4d7f3f;" vertex="1" parent="1">
          <mxGeometry x="1200" y="390" width="380" height="390" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="Aai_Platnosci_Cena&lt;br&gt;→ aai_sklep_cena_kursu&lt;br&gt;&lt;br&gt;cena EFEKTYWNA z Woo (z promocją).&lt;br&gt;Bez tej wtyczki strona pokazuje&lt;br&gt;cenę katalogową — i tak było w W1–W6." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#3a6ea5;" vertex="1" parent="1">
          <mxGeometry x="1225" y="435" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="Aai_Platnosci_Cta&lt;br&gt;→ aai_sklep_cta_kursu&lt;br&gt;→ aai_sklep_dostepnosc_kursu&lt;br&gt;&lt;br&gt;Ten sam warunek steruje przyciskiem&lt;br&gt;i znacznikiem PreOrder/InStock." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#3a6ea5;" vertex="1" parent="1">
          <mxGeometry x="1225" y="545" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="Aai_Platnosci_Szew&lt;br&gt;→ aai_sklep_zamowienia_w_drodze&lt;br&gt;&lt;br&gt;Plugin 1 przed usunięciem kursu pyta,&lt;br&gt;czy ktoś ma złożone i nieopłacone&lt;br&gt;zamówienie. Przy błędzie oddajemy −1&lt;br&gt;= „nie wiem”, a Plugin 1 wtedy ODMAWIA." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#3a6ea5;" vertex="1" parent="1">
          <mxGeometry x="1225" y="655" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="n29" target="n35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t38" value="TRZY RZECZY, KTÓRE MUSZĄ ZOSTAĆ&lt;br&gt;&lt;br&gt;1. Filtry ustawień rejestrujemy PRZY INCLUDE pliku, nie na plugins_loaded — Tutor czyta monetize_by w swoim konstruktorze i filtr przyszedłby za późno.&lt;br&gt;&lt;br&gt;2. Znacznik dostawy jest ATOMOWY (UNIQUE w bazie), bo cudzy hak potrafi pobiec rekurencyjnie.&lt;br&gt;&lt;br&gt;3. Wyłączenie wtyczki zdejmuje produkty na draft — inaczej zostałyby kupowalne bez działającego szwu." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
          <mxGeometry x="1200" y="90" width="380" height="250" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="Aai_Platnosci_Posiadanie — KLASA-LIŚĆ&lt;br&gt;Co ten człowiek ma z tym kursem: nic · dostęp · zamówienie w drodze.&lt;br&gt;Jedno źródło tej decyzji dla przycisku, blokady drugiego zakupu i szwu.&lt;br&gt;Nie zna ANI JEDNEJ klasy tej wtyczki — pyta tylko Tutora i WordPressa." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="390" y="800" width="780" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e41" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;" edge="1" parent="1" source="n29" target="n40">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e42" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;" edge="1" parent="1" source="n18" target="n40">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e43" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;endArrow=block;" edge="1" parent="1" source="n12" target="n40">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="POZOSTAŁE KLASY&lt;br&gt;&lt;br&gt;Aai_Platnosci_Kasa — zdanie o zgodach w kasie:&lt;br&gt;  Woo powołuje się na regulamin, którego NIE MA;&lt;br&gt;  poprawia też odnośnik pozycji koszyka&lt;br&gt;Aai_Platnosci_Tabele — schemat obu tabel&lt;br&gt;Aai_Platnosci_Cli — sync · sprzedaz · dostawy · sprawdz&lt;br&gt;Aai_Platnosci_Zaleznosci — komunikat zamiast białego&lt;br&gt;  ekranu, gdy brakuje Woo albo Tutora&lt;br&gt;Aai_Platnosci_Komunikaty — kanał błędów szwu&lt;br&gt;Aai_Platnosci_Sitemap — nasze adresy poza mapą strony" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#3a6ea5;" vertex="1" parent="1">
          <mxGeometry x="770" y="640" width="400" height="145" as="geometry" />
        </mxCell>
      </root>
