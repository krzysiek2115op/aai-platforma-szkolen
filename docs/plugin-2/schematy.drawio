        <mxCell id="n28" value="Zapis na kurs (tutor_enrolled)&lt;br&gt;status zapisu IDZIE ZA statusem zamówienia&lt;br&gt;→ zwrot ODBIERA dostęp&lt;br&gt;   bez ani jednej linijki naszego kodu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#f0f0f0;strokeColor=#8a8a8a;dashed=1;" vertex="1" parent="1">
