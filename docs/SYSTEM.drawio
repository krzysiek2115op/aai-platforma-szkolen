        <mxCell id="t54" value="„WŁASNA BAZA” ZNACZY WŁASNE TABELE,&lt;br&gt;NIE OSOBNĄ BAZĘ MySQL&lt;br&gt;&lt;br&gt;Wszystko stoi w jednej bazie WordPressa, ale każda wtyczka ma własny prefiks i NIE dotyka cudzych tabel — pilnuje tego strażnik w CI.&lt;br&gt;&lt;br&gt;Dzięki jednej bazie działają transakcje, JOIN z kontami WordPressa i JEDNA kopia zapasowa." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
          <mxGeometry x="1560" y="110" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="t55" value="ŹRÓDŁO PRAWDY O KURSIE:&lt;br&gt;NASZE TABELE&lt;br&gt;&lt;br&gt;Do Tutora idzie KOPIA, zawsze w jedną stronę. Zmiana zrobiona w Course Builderze Tutora znika przy najbliższym zapisie kursu.&lt;br&gt;&lt;br&gt;Rozjazd tych dwóch kopii to główne ryzyko tej architektury — dlatego ma własną komendę kontrolną:&lt;br&gt;wp aai-sklep sprawdz-tutora" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
          <mxGeometry x="1560" y="390" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="t56" value="MOTYW „AUTOMATIC AI”&lt;br&gt;&lt;br&gt;jest osobny i generowany — nie wolno go edytować ręcznie.&lt;br&gt;&lt;br&gt;Wtyczki tylko się do niego dopasowują: pozycję w menu dokładamy w locie, a arkusze Tutora i WooCommerce zdejmujemy ze stron, na których nie mają nic do roboty." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
