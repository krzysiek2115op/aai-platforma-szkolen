        <mxCell id="n25" value="PLUGIN 1 — aai-sklep&lt;br&gt;28 klas · 5 tabel · 26 haków&lt;br&gt;&lt;br&gt;katalog · strony sprzedażowe · kreator&lt;br&gt;widok lekcji · „Moje kursy” · SEO i mapa strony&lt;br&gt;higiena cudzych arkuszy (Tutor/Woo nie łamią motywu)&lt;br&gt;&lt;br&gt;DZIAŁA SAM — bez pozostałych dwóch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#4d7f3f;" vertex="1" parent="1">
          <mxGeometry x="615" y="150" width="430" height="165" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="PLUGIN 2 — aai-platnosci&lt;br&gt;13 klas · 2 tabele · 25 haków&lt;br&gt;&lt;br&gt;SZEW, nie kasa: kurs → produkt WooCommerce&lt;br&gt;cena efektywna · 4 stany przycisku zakupu&lt;br&gt;domykanie zamówienia · dwa maile dostarczenia&lt;br&gt;&lt;br&gt;WYMAGA: Pluginu 1, WooCommerce, Tutora" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#3a6ea5;" vertex="1" parent="1">
          <mxGeometry x="615" y="385" width="430" height="165" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="PLUGIN 3 — aai-monitor&lt;br&gt;13 klas · 2 tabele · 10 haków&lt;br&gt;&lt;br&gt;dziennik logowań (90 dni, dane osobowe)&lt;br&gt;pomiar ruchu (400 dni, anonimowo)&lt;br&gt;ekran w kokpicie — czysty odczyt&lt;br&gt;&lt;br&gt;DZIAŁA SAM — rejestruje, niczego nie blokuje" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="615" y="620" width="430" height="165" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="KOLEJNOŚĆ INSTALACJI:  1 → 2 → 3&lt;br&gt;Plugin 2 bez Pluginu 1 nie ma czego sprzedawać.&lt;br&gt;Plugin 3 jest niezależny, ale idzie na końcu." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
