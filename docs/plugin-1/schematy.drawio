          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t28" value="DLACZEGO KOPIA, A NIE JEDNA BAZA&lt;br&gt;&lt;br&gt;Tutor daje logowanie i pilnuje dostępu — tego nie piszemy sami.&lt;br&gt;&lt;br&gt;Ale treść kursu ma jedno miejsce: naszą bazę. Do Tutora idzie kopia, zawsze w jedną stronę." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
