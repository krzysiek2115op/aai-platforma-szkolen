        <mxCell id="n24" value="WooCommerce&lt;br&gt;&lt;br&gt;koszyk, kasa, płatność, faktury,&lt;br&gt;konto klienta&lt;br&gt;&lt;br&gt;— steruje nim wtyczka 2 (Płatności)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#f0f0f0;strokeColor=#8a8a8a;dashed=1;" vertex="1" parent="1">
