          <mxGeometry x="450" y="590" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="WordPress&lt;br&gt;&lt;br&gt;konta i hasła, adresy stron,&lt;br&gt;mapa strony, panel administratora" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#f0f0f0;strokeColor=#8a8a8a;dashed=1;" vertex="1" parent="1">
