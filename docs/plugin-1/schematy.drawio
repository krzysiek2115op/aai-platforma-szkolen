        <mxCell id="t22" value="Ta baza jest ŹRÓDŁEM PRAWDY o kursie.&lt;br&gt;&lt;br&gt;Wszystko, co klient czyta, bierze się stąd — a nie z ustawień innej wtyczki." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="390" height="140" as="geometry" />
        </mxCell>
        <mxCell id="g23" value="Czego ta wtyczka NIE robi (robią to gotowe wtyczki obok)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#fafafa;strokeColor=#8a8a8a;dashed=1;" vertex="1" parent="1">
