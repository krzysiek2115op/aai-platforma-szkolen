        <mxCell id="t50" value="TRZY REGUŁY, KTÓRE TRZYMAJĄ TĘ WTYCZKĘ&lt;br&gt;&lt;br&gt;1. Do bazy pisze WYŁĄCZNIE Aai_Sklep_Zapis — pilnuje tego strażnik w CI.&lt;br&gt;&lt;br&gt;2. Kierunek do Tutora jest jednokierunkowy. Zmiana w Course Builderze znika przy najbliższym zapisie.&lt;br&gt;&lt;br&gt;3. Szablon frontu nie sięga po treść lekcji — dostaje gotowy HTML zza bramki dostępu." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="POZOSTAŁE KLASY&lt;br&gt;&lt;br&gt;Aai_Sklep_Tabele — schemat 5 tabel, dbDelta&lt;br&gt;Aai_Sklep_Menu — pozycje „Szkolenia” i „Moje&lt;br&gt;  kursy” w nawigacji motywu (podmiana HTML&lt;br&gt;  w locie, bo motyw nie ma wp_nav_menu)&lt;br&gt;Aai_Sklep_Import — wczytanie kursów z eksportu&lt;br&gt;Aai_Sklep_Raport — materiał dowodowy (sha256,&lt;br&gt;  liczniki) do porównania obu baz&lt;br&gt;Aai_Sklep_Zrzuty — 148 obrazów w bibliotece&lt;br&gt;  mediów, klucz: lekcja + nazwa&lt;br&gt;Aai_Sklep_Blad_Zapisu — wyjątek warstwy zapisu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#4d7f3f;" vertex="1" parent="1">
          <mxGeometry x="1250" y="90" width="320" height="290" as="geometry" />
