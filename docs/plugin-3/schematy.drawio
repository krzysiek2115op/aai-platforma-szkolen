        <mxCell id="g27" value="Ekran w kokpicie — CZYSTY ODCZYT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#fff7ef;strokeColor=#c07830;" vertex="1" parent="1">
