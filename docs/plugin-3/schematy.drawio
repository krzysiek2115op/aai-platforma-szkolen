        <mxCell id="n28" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#f0f0f0;strokeColor=#8a8a8a;" vertex="1" parent="1">
          <mxGeometry x="560" y="716" width="24" height="24" as="geometry" />
