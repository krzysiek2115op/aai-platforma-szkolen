<mxfile host="app.diagrams.net" agent="Automatic AI" type="device">
  <diagram id="1--Jak-to-dzia-a--dla-ka-dego-" name="1. Jak to działa (dla każdego)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="790" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="x1" value="Automatic AI — Monitoring: jak to działa" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="Wtyczka 3 z 3. Odpowiada na dwa pytania właściciela: kto wchodził na konta i co ludzie czytają. Niczego nie blokuje — tylko zapisuje." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="Czujka 1 — kto wchodził na konta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#fff7ef;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="700" height="320" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Ktokolwiek" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;strokeColor=#7a5c00;" vertex="1" parent="1">
          <mxGeometry x="80" y="190" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Loguje się&lt;br&gt;&lt;br&gt;udanie albo nieudanie&lt;br&gt;(także cudza próba)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#f0f0f0;strokeColor=#8a8a8a;" vertex="1" parent="1">
          <mxGeometry x="160" y="165" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="Dziennik logowań&lt;br&gt;&lt;br&gt;kiedy · kto · skąd (IP)&lt;br&gt;przeglądarka&lt;br&gt;&lt;br&gt;żyje 90 dni" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="450" y="160" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="a4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="zapisujemy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="n5" target="d6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="PO CO: żeby było widać serię nieudanych prób z jednego adresu — czyli próbę włamania na konto klienta albo właściciela.&lt;br&gt;&lt;br&gt;HASEŁ NIE ZAPISUJEMY NIGDY. Gdy ktoś wpisze hasło w pole loginu, zostaje z niego tylko początek i długość." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
          <mxGeometry x="160" y="290" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="g10" value="Czujka 2 — co ludzie czytają" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#fff7ef;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="740" height="320" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="Odwiedzający" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;strokeColor=#7a5c00;" vertex="1" parent="1">
          <mxGeometry x="840" y="190" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="Czyta stronę&lt;br&gt;&lt;br&gt;katalog, strona kursu,&lt;br&gt;lekcja" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#d5e8d4;strokeColor=#4d7f3f;" vertex="1" parent="1">
          <mxGeometry x="920" y="165" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d13" value="Pomiar ruchu&lt;br&gt;&lt;br&gt;adres · kiedy · jak długo&lt;br&gt;&lt;br&gt;ANONIMOWO, żyje 400 dni" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1230" y="160" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="a11" target="n12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="zapisujemy&lt;br&gt;przy wyjściu ze strony" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="n12" target="d13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t16" value="TU NIE MA ANI IP, ANI KONTA, ANI PRZEGLĄDARKI — nic, co łączyłoby odsłonę z człowiekiem. Obu tabel nie da się ze sobą połączyć i to jest celowe.&lt;br&gt;&lt;br&gt;Administratora NIE mierzymy w ogóle." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
          <mxGeometry x="920" y="290" width="590" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="Ekran „Monitoring” w panelu WordPressa&lt;br&gt;&lt;br&gt;· cztery liczby na wierzchu, każda z własnym okresem&lt;br&gt;· dziennik logowań (z filtrem „tylko nieudane”)&lt;br&gt;· ruch: dziś / 7 dni / 30 dni&lt;br&gt;· najczęściej czytane strony&lt;br&gt;· osobno: kto odbił się od logowania" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#ffe6cc;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="560" y="500" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=1.5;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="d6" target="n17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=1.5;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="d13" target="n17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a20" value="Właściciel" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;strokeColor=#7a5c00;" vertex="1" parent="1">
          <mxGeometry x="1120" y="540" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e21" value="tylko on to widzi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="n17" target="a20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t22" value="CZEGO TU NIE MA — I TO JEST DECYZJA, NIE BRAK&lt;br&gt;&lt;br&gt;· nie blokujemy nikogo, nawet po serii nieudanych prób;&lt;br&gt;· nie pokazujemy sprzedaży — od tego są raporty WooCommerce;&lt;br&gt;· nie ma zewnętrznej analityki, żadne dane nie wychodzą poza tę stronę." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="x23" value="Legenda:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=12;fillColor=#ffe6cc;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="40" y="716" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="x25" value="nasza wtyczka „Monitoring”" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="74" y="716" width="260" height="24" as="geometry" />
