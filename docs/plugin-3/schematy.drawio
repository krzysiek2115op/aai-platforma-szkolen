  <diagram id="2--Architektura--techniczny-" name="2. Architektura (techniczny)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="x1" value="aai-monitor — architektura (Plugin 3)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="13 klas · 2 tabele · 10 haków · wystrzałem jest admin-post.php (zero REST, zero wp_ajax_*) · ekran to CZYSTY ODCZYT" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="BAZA  wp_aai_monitor_*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="300" height="290" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="logowania&lt;br&gt;czas · zdarzenie · zrodlo&lt;br&gt;user_id · login · ip · agent&lt;br&gt;&lt;br&gt;DANE OSOBOWE — 90 dni" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="65" y="130" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="wizyty&lt;br&gt;odslona (UNIQUE) · sesja&lt;br&gt;sciezka · bramka · wejscie&lt;br&gt;trwanie_ms&lt;br&gt;&lt;br&gt;ANONIMOWE — 400 dni, sufit 250k" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="65" y="252" width="250" height="115" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="TE DWIE TABELE NIE MAJĄ ŻADNEJ WSPÓLNEJ KOLUMNY.&lt;br&gt;&lt;br&gt;Złączenie dałoby profilowanie, którego ten moduł z założenia nie robi — więc nie ma po czym ich skleić." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fffde7;strokeColor=#c8b900;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="DZIAŁ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#fff7ef;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="390" y="90" width="330" height="290" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Aai_Monitor_Zapis&lt;br&gt;JEDYNY PISARZ&lt;br&gt;&lt;br&gt;· sufity: 4 h czytania (PRZYCINA),&lt;br&gt;  30 dni wieku (ODRZUCA)&lt;br&gt;· kolejne beacony podnoszą wiersz&lt;br&gt;  (GREATEST / LEAST w SQL-u)&lt;br&gt;· retencja przy każdym zapisie" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="410" y="130" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Aai_Monitor_Odczyt&lt;br&gt;kanał JSON — NIGDY nie pisze&lt;br&gt;gotowe agregaty, nie surowe wiersze&lt;br&gt;okna liczone od północy czasu WITRYNY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="410" y="275" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="n8" target="d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="n8" target="d5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=1.5;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="d4" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=1.5;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="d5" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g14" value="Czujka 1 — dziennik logowań (haki rdzenia)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#fff7ef;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="770" y="90" width="400" height="290" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="Aai_Monitor_Logowania   priorytet 1&lt;br&gt;&lt;br&gt;· set_logged_in_cookie → wiersz „sesja”&lt;br&gt;· wp_login → DOPRECYZOWUJE na „formularz”&lt;br&gt;· wp_login_failed → wiersz „nieudane”&lt;br&gt;&lt;br&gt;DWA haki na sukces, bo auto-login z kasy&lt;br&gt;WooCommerce NIE odpala wp_login —&lt;br&gt;czyli ścieżka każdego nowego klienta.&lt;br&gt;&lt;br&gt;KAŻDY handler w try/catch(Throwable):&lt;br&gt;wyjątek z set_logged_in_cookie wychodzi&lt;br&gt;z kasy Woo = HTTP 500 i przerwany zakup.&lt;br&gt;&lt;br&gt;Hasła nie zapisujemy — login nieistniejącego&lt;br&gt;konta jest MASKOWANY (adm…(19 znaków))." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="795" y="130" width="350" height="235" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="n15" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g17" value="Czujka 2 — pomiar ruchu (wystrzał)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;dashed=0;opacity=100;fillColor=#fff7ef;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="770" y="420" width="800" height="350" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="Aai_Monitor_Pomiar   (serwer)&lt;br&gt;podaje assets/pomiar.js na front&lt;br&gt;&lt;br&gt;NIE podaje go: administratorowi ani na 404&lt;br&gt;— strona 404 renderuje się dla DOWOLNEGO&lt;br&gt;adresu, więc rozdawałaby podpisy na&lt;br&gt;ścieżki, których nie ma." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="795" y="465" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="pomiar.js   (przeglądarka)&lt;br&gt;mierzy CZAS AKTYWNY — zegar stoi,&lt;br&gt;gdy karta jest ukryta&lt;br&gt;&lt;br&gt;· visibilitychange + pagehide → beacon&lt;br&gt;· pageshow.persisted (bfcache) → NOWA odsłona&lt;br&gt;· identyfikator sesji w sessionStorage&lt;br&gt;· navigator.webdriver → nie mierzymy&lt;br&gt;· sendBeacon z Blobem application/json" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="795" y="610" width="340" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="Aai_Monitor_Wizyty   —  admin-post.php&lt;br&gt;akcja: aai_monitor_wizyta  (w QUERY STRINGU!)&lt;br&gt;&lt;br&gt;Rejestrujemy OBIE nazwy haka:&lt;br&gt;admin_post_nopriv_  I  admin_post_&lt;br&gt;— bo strony lekcji są za logowaniem.&lt;br&gt;&lt;br&gt;SITO, w tej kolejności (najpierw darmowe):&lt;br&gt;1. administrator → odrzut&lt;br&gt;2. Content-Type musi być application/json&lt;br&gt;   (text/plain przechodzi cross-origin!)&lt;br&gt;3. Origin / Referer = nasza witryna&lt;br&gt;4. limiter 300/min, okno kotwiczone&lt;br&gt;   do pełnej minuty zegara&lt;br&gt;5. ciało STRUMIENIEM, sufit 1024 B&lt;br&gt;6. ścieżka + PODPIS&lt;br&gt;7. sesja i odsłona: 32 znaki hex&lt;br&gt;&lt;br&gt;ODPOWIADAMY 204 NA WSZYSTKO —&lt;br&gt;i na przyjęcie, i na odrzut." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="1180" y="465" width="370" height="290" as="geometry" />
        </mxCell>
        <mxCell id="e21" value="podpisana ścieżka + flaga bramki" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="n18" target="n19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" value="beacon" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="n19" target="n20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;strokeWidth=3;" edge="1" parent="1" source="n20" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="Aai_Monitor_Podpis&lt;br&gt;&lt;br&gt;Strona przy renderze PODPISUJE własną&lt;br&gt;ścieżkę (HMAC, własna sól w opcji).&lt;br&gt;Beacon podpis odsyła.&lt;br&gt;&lt;br&gt;ODWRÓCONE PYTANIE: zamiast „czy ta&lt;br&gt;ścieżka istnieje” (url_to_postid zwraca&lt;br&gt;0 dla WSZYSTKICH naszych tras)&lt;br&gt;dowodzimy, że stronę wyrenderowano.&lt;br&gt;&lt;br&gt;Flaga „bramka logowania” jest CZĘŚCIĄ&lt;br&gt;podpisywanego materiału — nie da się&lt;br&gt;jej podrobić." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#c07830;" vertex="1" parent="1">
          <mxGeometry x="400" y="560" width="300" height="195" as="geometry" />
