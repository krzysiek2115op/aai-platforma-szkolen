        <mxCell id="x27" value="nasza wtyczka „Sklep”" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="354" y="716" width="240" height="24" as="geometry" />
