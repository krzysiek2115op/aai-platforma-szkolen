{
  "name": "pod-strona-szkolenia",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:podglad": "PODGLAD_STATYCZNY=1 next build && node tools/og-rozszerzenie.mjs out && node tools/csp-podglad.mjs out",
    "deploy:podglad": "bash tools/deploy-podglad.sh",
    "start": "next start -p 3001",
    "lint": "eslint",
    "smoke": "node --env-file-if-exists=.env tools/smoke/smoke-d4.ts && node --env-file-if-exists=.env tools/smoke/smoke-d5.ts && node --env-file-if-exists=.env tools/smoke/smoke-d6.ts && node --env-file-if-exists=.env tools/smoke/smoke-lekcje.ts && node --env-file-if-exists=.env tools/smoke/smoke-csp.ts && node --env-file-if-exists=.env tools/smoke/smoke-podglad.ts && node --env-file-if-exists=.env tools/smoke/smoke-seo.ts",
    "check": "node tools/straznicy/uruchom-wszystkie.mjs && npm run lint && npx tsc --noEmit && npm test && npm run build && npm run smoke",
    "pretest": "node tools/db1-gotowa.mjs",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"modules/**/*.test.ts\" \"components/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "db1:up": "podman compose up -d db1",
    "db1:migruj": "node --env-file-if-exists=.env modules/m1-sklep/db/migruj.ts",
    "db1:seed": "node --env-file-if-exists=.env tools/seed/seed-przyklady.ts",
    "db1:sekcje": "node --env-file-if-exists=.env tools/wgraj-sekcje.ts",
    "db1:tresc": "node --env-file-if-exists=.env tools/wgraj-tresc-lekcji.ts",
    "wp:eksport": "node --env-file-if-exists=.env tools/eksport-wp.mjs --do eksport-wp",
    "wp:import": "npm run wp:eksport && podman cp eksport-wp/kursy.json ${STACK_NAZWA:-aai_wp}_cli:/tmp/kursy.json && podman exec ${STACK_NAZWA:-aai_wp}_cli wp --path=/var/www/html aai-sklep import /tmp/kursy.json && npm run wp:sync-platnosci",
    "pakuj": "node tools/pakuj-wtyczki.mjs",
    "schematy": "node tools/schematy.mjs",
    "wp:sprawdz": "node --env-file-if-exists=.env tools/sprawdz-import-wp.mjs",
    "wp:sync": "podman exec ${STACK_NAZWA:-aai_wp}_cli wp --path=/var/www/html aai-sklep sync",
    "wp:tutor": "podman exec ${STACK_NAZWA:-aai_wp}_cli wp --path=/var/www/html aai-sklep sprawdz-tutora",
    "wp:zrzuty": "node tools/wgraj-zrzuty-wp.mjs",
    "wp:proza": "node tools/sprawdz-proze-php.mjs",
    "wp:klient": "node tools/wp-klient-testowy.mjs",
    "smoke:wp": "node tools/smoke/smoke-wp-dane.mjs",
    "smoke:wp-front": "node tools/smoke/smoke-wp-front.mjs",
    "smoke:wp-motyw": "node tools/smoke/smoke-wp-motyw.mjs",
    "smoke:wp-kreator": "node tools/smoke/smoke-wp-kreator.mjs",
    "smoke:wp-tutor": "node tools/smoke/smoke-wp-tutor.mjs",
    "smoke:wp-lekcja": "node tools/smoke/smoke-wp-lekcja.mjs",
    "smoke:wp-panel": "node tools/smoke/smoke-wp-panel.mjs",
    "smoke:wp-platnosci": "node tools/smoke/smoke-wp-platnosci.mjs",
    "wp:sync-platnosci": "podman exec ${STACK_NAZWA:-aai_wp}_cli wp --path=/var/www/html aai-platnosci sync",
    "smoke:wp-produkty": "node tools/smoke/smoke-wp-produkty.mjs",
    "smoke:wp-zakup": "node tools/smoke/smoke-wp-zakup.mjs",
    "smoke:wp-jezyk": "node tools/smoke/smoke-wp-jezyk.mjs",
    "smoke:wp-maile": "node tools/smoke/smoke-wp-maile.mjs",
    "smoke:wp-zwroty": "node tools/smoke/smoke-wp-zwroty.mjs",
    "smoke:wp-monitor": "node tools/smoke/smoke-wp-monitor.mjs",
    "smoke:wp-seo": "node tools/smoke/smoke-wp-seo.mjs",
    "ikony": "node tools/ikony-marki.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
