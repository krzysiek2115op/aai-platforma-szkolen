{
  "name": "pod-strona-szkolenia",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:podglad": "PODGLAD_STATYCZNY=1 next build && node tools/og-rozszerzenie.mjs out",
    "deploy:podglad": "bash tools/deploy-podglad.sh",
    "start": "next start -p 3001",
    "lint": "eslint",
    "pretest": "node tools/db1-gotowa.mjs",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"modules/**/*.test.ts\" \"components/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "db1:up": "podman compose up -d db1",
    "db1:migruj": "node --env-file-if-exists=.env modules/m1-sklep/db/migruj.ts",
    "db1:seed": "node --env-file-if-exists=.env tools/seed/seed-przyklady.ts"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
