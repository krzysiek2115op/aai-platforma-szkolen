# Skrypty shellowe i haki gita zawsze z końcami linii LF, niezależnie od
# core.autocrlf. Przy CRLF shebang staje się "#!/usr/bin/env bash\r"
# i skrypt nie startuje (bad interpreter) — dotyczy .githooks/ i CI.
*.sh            text eol=lf
.githooks/*     text eol=lf

# Domyślnie: git sam wykrywa tekst i normalizuje końce linii w repo.
# Bez tej linii zachowanie zależy od `core.autocrlf` KAŻDEGO klonu
# z osobna — ten sam plik potrafi wejść do historii raz z LF, raz z CRLF.
* text=auto

# Pliki binarne WPROST. Git zwykle wykrywa je sam, ale heurystyka bywa
# zawodna na małych plikach; uszkodzony normalizacją obraz albo font
# widać dopiero u odwiedzającego. Zrzuty kursów (148 × .webp) i fonty
# Geist (.woff2) to treść produktu — tu pomyłka kosztuje najwięcej.
*.webp          binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.ico           binary
*.woff2         binary

# Plik blokady — bez ogromnych diffów przy przeglądzie PR-a.
package-lock.json   -diff
